#include <stdio.h>
#include <string.h>

int linearSearch(char arr[][20], int n, char *key) {
    int count = 0;
    for (int i = 0; i < n; i++) {
        count++;
        if (strcmp(arr[i], key) == 0) {
            printf("Linear: found at index %d, comparisons = %d\n", i, count);
            return count;
        }
    }
    printf("Linear: not found, comparisons = %d\n", count);
    return count;
}

int binarySearch(char arr[][20], int n, char *key) {
    int low = 0, high = n - 1, count = 0;

    while (low <= high) {
        count++;
        int mid = (low + high) / 2;
        int cmp = strcmp(arr[mid], key);

        if (cmp == 0) {
            printf("Binary: found at index %d, comparisons = %d\n", mid, count);
            return count;
        } else if (cmp < 0) {
            low = mid + 1;
        } else {
            high = mid - 1;
        }
    }
    printf("Binary: not found, comparisons = %d\n", count);
    return count;
}

int main() {
    char departments[8][20] = {
        "Backend", "CEO", "Development", "Finance",
        "Frontend", "HR", "IT", "Testing"
    };
    int n = 8;

    printf("Departments (sorted): ");
    for (int i = 0; i < n; i++)
        printf("%s ", departments[i]);
    printf("\n\n");

    char searchList[4][20] = {"Backend", "IT", "HR", "Finance"};

    for (int i = 0; i < 4; i++) {
        printf("Key: %s\n", searchList[i]);
        linearSearch(departments, n, searchList[i]);
        binarySearch(departments, n, searchList[i]);
        printf("\n");
    }

    return 0;
}
/*For the department search, four keys were tested — Backend, IT, HR, and Finance — on the same sorted list of 8 departments.

When searching for "Backend", linear search found it in 1 comparison because it was the first element, while binary search took 3 comparisons.

When searching for "IT", linear search needed 7 comparisons since it was near the end of the list, but binary search found it in only 2 comparisons.

When searching for "HR", linear search took 6 comparisons, while binary search again finished in just 2 comparisons.

When searching for "Finance", linear search took 4 comparisons, and binary search took only 1 comparison because it was the middle element.

From these results, it is clear that linear search depends on the position of the key in the list — it may take anywhere from 1 to 8 comparisons. Binary search, on the other hand, always finishes within 3 comparisons or fewer because it repeatedly divides the sorted list in half. So binary search is faster and more efficient than linear search for this department search operation.
*/
